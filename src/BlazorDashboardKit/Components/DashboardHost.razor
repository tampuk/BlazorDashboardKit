@using System.Security.Claims
@using System.Text.Json
@using System.Text.Json.Nodes
@using Microsoft.AspNetCore.Components.Authorization
@inject DashboardService DashboardService
@inject WidgetRegistry WidgetRegistry
@inject IWidgetAccessControl AccessControl
@inject DashboardJsInterop JsInterop
@implements IAsyncDisposable

@if (_activeDashboard is null)
{
    @* No owner / nothing resolved: render an empty container without touching the store or JS. *@
    <div class="dashboard-empty-container"></div>
}
else
{
    <div class="dashboard-header mb-3">
        <div class="dashboard-tabs-bar">
            <div class="dashboard-tabs">
                @if (_collection is not null)
                {
                    foreach (var d in _collection.Dashboards)
                    {
                        var isActive = d.Id == _activeDashboard.Id;

                        <div class="dashboard-tab @(isActive ? "active" : "")" @onclick="() => SwitchDashboard(d.Id)">
                            @if (EditMode && isActive)
                            {
                                <input type="text" class="tab-name-input"
                                       value="@d.Name" aria-label="Dashboard name"
                                       @onchange="OnDashboardNameChanged" @onclick:stopPropagation="true" />
                            }
                            else
                            {
                                @* No handler here: the click bubbles to the parent div,
                                which owns the switch. The button is kept for semantics
                                and keyboard activation (Enter/Space bubble too). *@
                                <button type="button" class="tab-title-btn">
                                    @d.Name
                                </button>
                            }

                            @if (EditMode && _collection.Dashboards.Count > 1)
                            {
                                <button type="button" class="tab-action-btn tab-close-btn" title="Close tab" disabled="@_widgetEditMode"
                                        @onclick="() => _pendingDeleteDashboardId = d.Id" @onclick:stopPropagation="true">
                                    ×
                                </button>
                            }
                        </div>
                    }
                }
                @if (EditMode)
                {
                    <button type="button" class="tab-add-btn" title="New dashboard" disabled="@_widgetEditMode" @onclick="AddDashboard">
                        <span aria-hidden="true">+</span>
                    </button>
                }
            </div>

            <div class="dashboard-header-actions">
                @if (EditMode)
                {
                    var pickerCtx = new WidgetPickerContext(_availableWidgets,
                        EventCallback.Factory.Create<WidgetDescriptor>(this, AddWidget));
                    @if (WidgetPickerTemplate is not null)
                    {
                        @WidgetPickerTemplate(pickerCtx)
                    }
                    else if (WidgetPickerComponent is not null)
                    {
                        <DynamicComponent Type="WidgetPickerComponent"
                                          Parameters="@(new Dictionary<string, object> { ["Context"] = pickerCtx })" />
                    }
                    else
                    {
                        <WidgetPicker Available="_availableWidgets" OnWidgetAdded="AddWidget" />
                    }

                    @if (_actionsOpen)
                    {
                        <div class="bdk-dropdown-backdrop" @onclick="() => _actionsOpen = false"></div>
                    }
                    <div class="dropdown @(_actionsOpen ? "show" : null)"
                         @onkeydown="@(e => { if (e.Key == "Escape") _actionsOpen = false; })">
                        <button class="btn btn-outline-secondary btn-sm dropdown-toggle" type="button"
                                @onclick="ToggleActions" disabled="@_widgetEditMode"
                                aria-expanded="@(_actionsOpen ? "true" : "false")">
                            Actions
                        </button>
                        <div class="dropdown-menu dropdown-menu-end @(_actionsOpen ? "show" : null)">
                            <button class="dropdown-item" @onclick="ExportDashboard">Export</button>
                            <label class="dropdown-item mb-0" style="cursor: pointer;">
                                Import
                                <input type="file" accept=".json" @ref="_importFileInput" @onchange="ImportDashboard" hidden />
                            </label>
                        </div>
                    </div>
                    <button class="btn btn-primary btn-sm" disabled="@_widgetEditMode" @onclick="ExitEditMode">Done</button>
                }
                else
                {
                    @if (!ReadOnly)
                    {
                        <button class="btn btn-link btn-sm text-decoration-none" @onclick="EnterEditMode">Edit</button>
                    }
                }
            </div>
        </div>
    </div>

    <div id="@_gridContainerId" class="grid-stack @(EditMode ? "dashboard-edit" : "") @(_interactive && _gridInitialized ? null : "bdk-grid-static")">
        @if (_activeDashboard is not null && _activeDashboard.Widgets.Count > 0)
        {
            @foreach (var wp in ComputeGridPositions())
            {
                var descriptor = WidgetRegistry.GetDescriptor(wp.Placement.WidgetType);
                var isConfiguring = _configuringPlacement?.Id == wp.Placement.Id;
                <div @key="wp.Placement.Id"
                     class="grid-stack-item @(isConfiguring ? "widget-configuring" : "")"
                     gs-id="@wp.Placement.Id"
                     gs-x="@wp.X"
                     gs-y="@wp.Y"
                     gs-w="@wp.W"
                     gs-h="@wp.Placement.RowSpan"
                     gs-min-w="@(descriptor?.MinColumnSize)"
                     gs-max-w="@(descriptor?.MaxColumnSize)"
                     gs-min-h="@(descriptor?.MinRowSpan)"
                     gs-max-h="@(descriptor?.MaxRowSpan)"
                     gs-locked="@(wp.Placement.Locked ? "true" : null)"
                     gs-no-move="@(wp.Placement.Locked ? "true" : null)"
                     gs-no-resize="@(wp.Placement.Locked ? "true" : null)">
                    <div class="grid-stack-item-content">
                        @if (descriptor is null)
                        {
                            var uctx = new WidgetUnavailableContext(wp.Placement, EditMode,
                                EventCallback.Factory.Create(this, () => RemoveWidget(wp.Placement)));
                            @if (WidgetUnavailableTemplate is not null)
                            {
                                @WidgetUnavailableTemplate(uctx)
                            }
                            else if (WidgetUnavailableComponent is not null)
                            {
                                <DynamicComponent Type="WidgetUnavailableComponent"
                                                  Parameters="@(new Dictionary<string, object> { ["Context"] = uctx })" />
                            }
                            else
                            {
                                <WidgetUnavailable Placement="wp.Placement"
                                                   EditMode="EditMode"
                                                   OnRemove="uctx.Remove" />
                            }
                        }
                        else
                        {
                            <WidgetContainer Placement="wp.Placement"
                                             Descriptor="descriptor"
                                             StoreId="@string.Empty"
                                             UserId="@string.Empty"
                                             EditMode="EditMode"
                                             WidgetEditMode="_widgetEditMode"
                                             ShowDebugInfo="ShowDebugInfo"
                                             ReadOnly="ReadOnly"
                                             HostInteractive="_interactive"
                                             OnConfigChanged="(config) => OnWidgetConfigChanged(wp.Placement, config)"
                                             OnEditModeChanged="OnWidgetEditMode"
                                             OnRemove="() => RemoveWidget(wp.Placement)"
                                             OnSizeChanged="(_) => OnWidgetSizeChanged()"
                                             OnToggleLock="() => ToggleWidgetLock(wp.Placement)"
                                             OnDuplicate="() => DuplicateWidget(wp.Placement)"
                                             HeaderTemplate="WidgetHeaderTemplate"
                                             HeaderComponent="WidgetHeaderComponent"
                                             ErrorTemplate="WidgetErrorTemplate"
                                             ErrorComponent="WidgetErrorComponent"
                                             OnConfigure="() => OpenConfigPanel(wp.Placement, descriptor)" />
                        }
                    </div>
                </div>
            }
        }
        else if (_activeDashboard is not null)
        {
            var emptyCtx = new EmptyDashboardContext(EditMode);
            @if (EmptyTemplate is not null)
            {
                @EmptyTemplate(emptyCtx)
            }
            else if (EmptyComponent is not null)
            {
                <DynamicComponent Type="EmptyComponent"
                                  Parameters="@(new Dictionary<string, object> { ["Context"] = emptyCtx })" />
            }
            else
            {
                <div class="dashboard-empty text-center py-5">
                    <h5 class="text-muted mb-3">This dashboard is empty</h5>
                    <p class="text-secondary mb-3">Add widgets in edit mode to get started.</p>
                </div>
            }
        }
    </div>

    <WidgetConfigPanel Visible="_configuringPlacement is not null"
                       ConfigComponentType="_configuringDescriptor?.ConfigComponentType"
                       Config="@(_configuringPlacement?.Config ?? new JsonObject())"
                       ConfigChanged="SaveWidgetConfig"
                       ShellTemplate="ConfigPanelTemplate"
                       ShellComponent="ConfigPanelComponent"
                       OnClose="CloseConfigPanel" />

    @if (_pendingDeleteDashboardId is not null)
    {
        var dashboardToDelete = _collection?.Dashboards.FirstOrDefault(d => d.Id == _pendingDeleteDashboardId);
        if (dashboardToDelete is not null)
        {
            <div class="bdk-modal-container">
                <div class="bdk-modal-backdrop" @onclick="() => _pendingDeleteDashboardId = null"></div>
                <div class="bdk-modal-dialog" role="dialog" aria-modal="true" aria-labelledby="bdk-delete-modal-title" @onclick:stopPropagation>
                    <div class="bdk-modal-header">
                        <h5 class="bdk-modal-title" id="bdk-delete-modal-title">Delete Dashboard</h5>
                        <button type="button" class="bdk-modal-close-btn" aria-label="Close" @onclick="() => _pendingDeleteDashboardId = null">×</button>
                    </div>
                    <div class="bdk-modal-body">
                        <p>Are you sure you want to delete <strong>@dashboardToDelete.Name</strong>? This action cannot be undone.</p>
                    </div>
                    <div class="bdk-modal-footer">
                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => _pendingDeleteDashboardId = null">Cancel</button>
                        <button type="button" class="btn btn-sm btn-danger" @onclick="ConfirmDeleteDashboard">Delete</button>
                    </div>
                </div>
            </div>
        }
    }
}

@code {
    [Parameter, EditorRequired] public string OwnerKey { get; set; } = default!;
    [Parameter] public bool EditMode { get; set; }
    [Parameter] public bool ReadOnly { get; set; }
    /// <summary>Opt-in: show the per-widget placement debug label in edit mode. Off by default.</summary>
    [Parameter] public bool ShowDebugInfo { get; set; }
    /// <summary>Tune the grid (columns, cell height, margin, responsiveness). Defaults match the kit's built-in behaviour.</summary>
    [Parameter] public DashboardGridOptions? GridOptions { get; set; }
    /// <summary>Raised after the dashboard is persisted (any add/remove/move/resize/config/rename/import). For external sync, analytics, etc.</summary>
    [Parameter] public EventCallback OnDashboardChanged { get; set; }
    /// <summary>Override the widget edit-mode header with your own RenderFragment.</summary>
    [Parameter] public RenderFragment<WidgetHeaderContext>? WidgetHeaderTemplate { get; set; }
    /// <summary>Override the widget edit-mode header with your own component (gets [Parameter] WidgetHeaderContext Context). Ignored when WidgetHeaderTemplate is set.</summary>
    [Parameter] public Type? WidgetHeaderComponent { get; set; }
    /// <summary>Override the empty-dashboard state (RenderFragment).</summary>
    [Parameter] public RenderFragment<EmptyDashboardContext>? EmptyTemplate { get; set; }
    /// <summary>Override the empty-dashboard state (component; gets [Parameter] EmptyDashboardContext Context).</summary>
    [Parameter] public Type? EmptyComponent { get; set; }
    /// <summary>Override the "widget type not registered" placeholder (RenderFragment).</summary>
    [Parameter] public RenderFragment<WidgetUnavailableContext>? WidgetUnavailableTemplate { get; set; }
    /// <summary>Override the "widget type not registered" placeholder (component; gets [Parameter] WidgetUnavailableContext Context).</summary>
    [Parameter] public Type? WidgetUnavailableComponent { get; set; }
    /// <summary>Override the widget error state (RenderFragment).</summary>
    [Parameter] public RenderFragment<WidgetErrorContext>? WidgetErrorTemplate { get; set; }
    /// <summary>Override the widget error state (component; gets [Parameter] WidgetErrorContext Context).</summary>
    [Parameter] public Type? WidgetErrorComponent { get; set; }
    /// <summary>Override the Add-Widget picker (RenderFragment).</summary>
    [Parameter] public RenderFragment<WidgetPickerContext>? WidgetPickerTemplate { get; set; }
    /// <summary>Override the Add-Widget picker (component; gets [Parameter] WidgetPickerContext Context).</summary>
    [Parameter] public Type? WidgetPickerComponent { get; set; }
    /// <summary>Override the config-panel shell/chrome (RenderFragment); the kit still owns the working copy + Save/Cancel.</summary>
    [Parameter] public RenderFragment<WidgetConfigShellContext>? ConfigPanelTemplate { get; set; }
    /// <summary>Override the config-panel shell (component; gets [Parameter] WidgetConfigShellContext Context).</summary>
    [Parameter] public Type? ConfigPanelComponent { get; set; }

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private DashboardCollection? _collection;
    private DashboardDefinition? _activeDashboard;
    private IReadOnlyList<WidgetDescriptor> _availableWidgets = Array.Empty<WidgetDescriptor>();
    private bool _widgetEditMode;
    private bool _actionsOpen;

    // Tracks the ID of the dashboard pending deletion via the modal dialog
    private string? _pendingDeleteDashboardId;

    private DotNetObjectReference<object>? _dotNetRef;
    private readonly CancellationTokenSource _disposeCts = new();
    private readonly string _gridContainerId = "bdk-grid-" + Guid.NewGuid().ToString("N");
    private ElementReference _importFileInput;
    private bool _gridInitialized;
    private string? _loadedOwnerKey;
    private bool _interactive;

    // Widget config panel state
    private WidgetPlacement? _configuringPlacement;
    private WidgetDescriptor? _configuringDescriptor;
    private bool _pendingConfiguration; // true when a newly added widget requires config before saving

    // Render-mode awareness.
    //
    // The spec calls for `RendererInfo.IsInteractive`, but that ComponentBase property
    // was introduced in .NET 9; this RCL targets net8.0 where it does not exist. The
    // net8-correct substitute with identical semantics for our purpose: a component is
    // only "interactive" once it reaches an interactive render. Static SSR and the
    // prerender pass never invoke OnAfterRenderAsync (the component is later re-rendered
    // by the interactive runtime, which is when OnAfterRenderAsync fires) — so reaching
    // OnAfterRenderAsync IS the net8 signal that JS is usable. Until then `_interactive`
    // stays false and every JsInterop.* call no-ops, so nothing touches JS during
    // static SSR / prerender. The flag is threaded into every JsInterop.* call exactly
    // as the explicit `interactive` parameter that DashboardJsInterop expects.
    private bool Interactive => _interactive;

    protected override async Task OnParametersSetAsync()
    {
        // Treat null/empty as "no owner": never key the store on an empty string.
        // Re-resolve only when the owner key actually changes, so parameter passes
        // that don't change the owner (e.g. EditMode toggles) don't reload + clobber
        // unsaved in-memory placement edits.
        if (string.IsNullOrEmpty(OwnerKey))
        {
            _collection = null;
            _activeDashboard = null;
            _loadedOwnerKey = null;
        }
        else if (_loadedOwnerKey != OwnerKey)
        {
            var (collection, active) = await DashboardService.ResolveAsync(OwnerKey, _disposeCts.Token);
            _collection = collection;
            _activeDashboard = active;
            _loadedOwnerKey = OwnerKey;
        }

        await RefreshAvailableWidgets();
        await base.OnParametersSetAsync();
    }

    /// <summary>
    /// Filters the registry's descriptors through <see cref="IWidgetAccessControl"/>
    /// before they reach the picker, so users never see widgets they cannot use.
    /// The authenticated user (when an auth context is cascaded) is passed through;
    /// it may legitimately be null for anonymous / host-without-auth scenarios.
    /// </summary>
    private async Task RefreshAvailableWidgets()
    {
        ClaimsPrincipal? user = AuthState is null ? null : (await AuthState).User;
        var allowed = new List<WidgetDescriptor>();
        foreach (var descriptor in WidgetRegistry.Descriptors)
        {
            if (await AccessControl.IsAllowedAsync(descriptor, user, _disposeCts.Token))
                allowed.Add(descriptor);
        }
        _availableWidgets = allowed;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Reaching OnAfterRenderAsync means an interactive renderer is driving this
        // component (static SSR / prerender never call it). This is the net8
        // equivalent of RendererInfo.IsInteractive == true.
        _interactive = true;

        // Static SSR / prerender: render markup only, never initialize Gridstack.
        // Only the interactive render owns JS. NOT gated on `firstRender`:
        // ResetGrid() (add/remove/import) destroys the grid and clears
        // _gridInitialized precisely so the *next* render re-initializes it.
        // `_gridInitialized` is the idempotency guard; gating on `firstRender`
        // here would permanently strand the grid after the first ResetGrid.
        if (Interactive && !_gridInitialized && _activeDashboard is not null)
        {
            _gridInitialized = true;
            // Reuse the cached _dotNetRef rather than creating a new (and never disposed)
            // DotNetObjectReference per ResetGrid call. JS-side callbacks don't care about
            // the generic type; matching InitGrid's <object> signature lets us cache one ref.
            _dotNetRef ??= DotNetObjectReference.Create<object>(this);
            await JsInterop.InitGridAsync(_gridContainerId, interactive: true, _disposeCts.Token, _dotNetRef, EditMode, GridOptions);
            // GridStack now owns layout: re-render so the static-fallback marker
            // class (bound to _gridInitialized) is removed. Without this,
            // OnAfterRenderAsync mutating state alone never re-renders, so the
            // `bdk-grid-static` !important rules keep overriding GridStack.
            // Guarded by `!_gridInitialized` above, so this runs once per init
            // cycle (no render loop).
            await InvokeAsync(StateHasChanged);
        }
    }

    /// <summary>
    /// Destroys the current gridstack instance and marks it for re-initialization
    /// on the next render. Call this whenever the dashboard widgets change wholesale
    /// (delete, import).
    /// </summary>
    private async Task ResetGrid()
    {
        if (_gridInitialized)
        {
            await JsInterop.DestroyGridAsync(Interactive, _disposeCts.Token);
            _gridInitialized = false;
        }
    }

    private async Task EnterEditMode()
    {
        EditMode = true;
        await JsInterop.SetEditModeAsync(true, Interactive, _disposeCts.Token);
    }

    private async Task ExitEditMode()
    {
        EditMode = false;
        _widgetEditMode = false;
        await JsInterop.SetEditModeAsync(false, Interactive, _disposeCts.Token);
        await SaveDashboard();
    }

    [JSInvokable]
    public async Task OnGridChanged(string changesJson)
    {
        if (_activeDashboard is null) return;

        // changesJson crosses the JS interop boundary; a malformed payload must
        // not throw out of this [JSInvokable] callback.
        List<GridChange>? changes;
        try
        {
            changes = JsonSerializer.Deserialize<List<GridChange>>(changesJson);
        }
        catch (JsonException)
        {
            return;
        }
        if (changes is null || changes.Count == 0) return;

        foreach (var change in changes)
        {
            var placement = _activeDashboard.Widgets.FirstOrDefault(w => w.Id == change.Id);
            if (placement is null) continue;
            // Persist the explicit column even when it's 0; nullable Offset
            // distinguishes "unset (auto-flow)" from "deliberately at column 0".
            placement.Offset = change.X;
            // Row is the authoritative gridstack y. Order is kept in sync for
            // backwards compatibility with pre-Row JSON and template ordering.
            placement.Row = change.Y;
            placement.Order = change.Y;
            placement.ColumnSize = change.W;
            placement.RowSpan = change.H;
        }

        await SaveDashboard();
        await InvokeAsync(StateHasChanged);
    }

    private sealed class GridChange
    {
        [System.Text.Json.Serialization.JsonPropertyName("id")] public string Id { get; set; } = "";
        [System.Text.Json.Serialization.JsonPropertyName("x")] public int X { get; set; }
        [System.Text.Json.Serialization.JsonPropertyName("y")] public int Y { get; set; }
        [System.Text.Json.Serialization.JsonPropertyName("w")] public int W { get; set; }
        [System.Text.Json.Serialization.JsonPropertyName("h")] public int H { get; set; }
    }

    private record struct WidgetPosition(WidgetPlacement Placement, int X, int Y, int W);

    /// <summary>
    /// Computes gridstack x/y positions for each widget. Widgets with explicit
    /// Row + Offset (the result of a prior drag-save cycle) are placed at exactly
    /// those coordinates so real GridStack arrangements with gaps or stacked
    /// widgets beside taller neighbours survive a save-reload cycle. Widgets
    /// without explicit positions (template-fresh) auto-flow via a packer that
    /// runs after the explicits, starting one row below the lowest explicit row.
    /// </summary>
    private List<WidgetPosition> ComputeGridPositions()
    {
        var result = new List<WidgetPosition>();
        if (_activeDashboard is null) return result;

        // Explicit (Row + Offset both set) — render at the persisted coordinates.
        var explicitlyPlaced = _activeDashboard.Widgets
            .Where(w => w.Row.HasValue && w.Offset.HasValue)
            .OrderBy(w => w.Row!.Value)
            .ThenBy(w => w.Offset!.Value)
            .ToList();

        foreach (var p in explicitlyPlaced)
        {
            result.Add(new WidgetPosition(p, p.Offset!.Value, p.Row!.Value, p.ColumnSize));
        }

        // Auto-flow — pack the rest after the lowest occupied row, in template Order.
        var autoFlow = _activeDashboard.Widgets
            .Where(w => !w.Row.HasValue || !w.Offset.HasValue)
            .OrderBy(w => w.Order)
            .ThenBy(w => w.Offset ?? int.MaxValue)
            .ToList();

        if (autoFlow.Count == 0) return result;

        var colCursor = 0;
        var row = explicitlyPlaced.Count > 0
            ? explicitlyPlaced.Max(p => p.Row!.Value + Math.Max(p.RowSpan, 1))
            : 0;
        var rowHeight = 0;

        foreach (var p in autoFlow)
        {
            var w = p.ColumnSize;
            var x = p.Offset ?? colCursor;

            if (x + w > 12)
            {
                row += Math.Max(rowHeight, 1);
                rowHeight = 0;
                x = 0;
            }

            result.Add(new WidgetPosition(p, x, row, w));
            colCursor = x + w;
            rowHeight = Math.Max(rowHeight, p.RowSpan);
        }

        return result;
    }

    private async Task AddWidget(WidgetDescriptor descriptor)
    {
        if (_activeDashboard is null) return;

        // Shift all existing widgets down by one
        foreach (var w in _activeDashboard.Widgets)
            w.Order++;

        var placement = new WidgetPlacement
        {
            WidgetType = descriptor.Type,
            ColumnSize = descriptor.DefaultColumnSize,
            RowSpan = descriptor.DefaultRowSpan,
            Order = 0
        };
        _activeDashboard.Widgets.Add(placement);

        if (descriptor.RequiresConfiguration)
        {
            // Don't save yet — open config panel and mark as pending
            _pendingConfiguration = true;
            _configuringPlacement = placement;
            _configuringDescriptor = descriptor;
        }
        else
        {
            await SaveDashboard();
        }

        await ResetGrid();
    }

    private async Task RemoveWidget(WidgetPlacement placement)
    {
        if (_activeDashboard is null) return;

        _activeDashboard.Widgets.Remove(placement);
        // Re-index order values in-place
        var ordered = _activeDashboard.Widgets.OrderBy(w => w.Order).ToList();
        for (int i = 0; i < ordered.Count; i++)
            ordered[i].Order = i;
        await SaveDashboard();
        // Rebuild the grid like AddWidget does: otherwise GridStack keeps a
        // stale model that still references the removed DOM node.
        await ResetGrid();
    }

    private async Task DuplicateWidget(WidgetPlacement source)
    {
        if (_activeDashboard is null) return;

        var clone = new WidgetPlacement
        {
            WidgetType = source.WidgetType,
            ColumnSize = source.ColumnSize,
            RowSpan = source.RowSpan,
            Order = source.Order + 1,
            // Independent config copy; never share the JsonObject instance.
            Config = source.Config?.DeepClone()?.AsObject(),
            // A fresh copy starts unlocked and auto-flows (no fixed x/y).
            Locked = false
        };
        foreach (var w in _activeDashboard.Widgets.Where(w => w.Order > source.Order))
            w.Order++;
        _activeDashboard.Widgets.Add(clone);

        await SaveDashboard();
        await ResetGrid();
    }

    private async Task ToggleWidgetLock(WidgetPlacement placement)
    {
        placement.Locked = !placement.Locked;
        await SaveDashboard();
        // Rebuild so GridStack picks up the changed gs-locked/no-move/no-resize.
        await ResetGrid();
    }

    private async Task OnWidgetConfigChanged(WidgetPlacement placement, JsonObject config)
    {
        placement.Config = config;
        await SaveDashboard();
    }

    private async Task OnWidgetSizeChanged()
    {
        await SaveDashboard();
    }

    private async Task OnWidgetEditMode(bool editing)
    {
        _widgetEditMode = editing;
        await InvokeAsync(StateHasChanged);
    }

    private void OpenConfigPanel(WidgetPlacement placement, WidgetDescriptor descriptor)
    {
        _configuringPlacement = placement;
        _configuringDescriptor = descriptor;
    }

    private async Task SaveWidgetConfig(JsonObject config)
    {
        if (_configuringPlacement is not null)
        {
            _configuringPlacement.Config = config;
            _pendingConfiguration = false;
            _configuringPlacement = null;
            _configuringDescriptor = null;
            await SaveDashboard();
        }
    }

    private Task CloseConfigPanel()
    {
        if (_pendingConfiguration && _configuringPlacement is not null && _activeDashboard is not null)
        {
            // User cancelled config for a newly added widget — remove it
            _activeDashboard.Widgets.Remove(_configuringPlacement);
            var ordered = _activeDashboard.Widgets.OrderBy(w => w.Order).ToList();
            for (int i = 0; i < ordered.Count; i++)
                ordered[i].Order = i;
            _activeDashboard.Widgets = ordered;
        }
        _pendingConfiguration = false;
        _configuringPlacement = null;
        _configuringDescriptor = null;
        return Task.CompletedTask;
    }

    private async Task OnDashboardNameChanged(ChangeEventArgs e)
    {
        if (_activeDashboard is null) return;
        var newName = e.Value?.ToString()?.Trim();
        if (!string.IsNullOrEmpty(newName))
        {
            _activeDashboard.Name = newName;
            await SaveDashboard();
        }
    }

    // Clears transient per-dashboard UI state so it can't leak across a switch.
    private void ResetTransientState()
    {
        _pendingConfiguration = false;
        _configuringPlacement = null;
        _configuringDescriptor = null;
        _widgetEditMode = false;
        _actionsOpen = false;
        _pendingDeleteDashboardId = null;
    }

    private async Task SwitchDashboard(string dashboardId)
    {
        if (_collection is null) return;
        var target = _collection.Dashboards.FirstOrDefault(d => d.Id == dashboardId);
        if (target is null || ReferenceEquals(target, _activeDashboard)) return;

        _activeDashboard = target;
        _collection.ActiveDashboardId = target.Id;
        ResetTransientState();
        await SaveDashboard();
        await ResetGrid();
    }

    private async Task AddDashboard()
    {
        if (_collection is null) return;
        var dashboard = new DashboardDefinition { Name = $"Dashboard {_collection.Dashboards.Count + 1}" };
        _collection.Dashboards.Add(dashboard);
        _activeDashboard = dashboard;
        _collection.ActiveDashboardId = dashboard.Id;
        ResetTransientState();
        await SaveDashboard();
        await ResetGrid();
    }

    private async Task ConfirmDeleteDashboard()
    {
        if (_pendingDeleteDashboardId is not null)
        {
            var idToDelete = _pendingDeleteDashboardId;
            _pendingDeleteDashboardId = null;
            await DeleteDashboard(idToDelete);
        }
    }

    private async Task DeleteDashboard(string dashboardId)
    {
        if (_collection is null) return;
        var target = _collection.Dashboards.FirstOrDefault(d => d.Id == dashboardId);
        if (target is null || _collection.Dashboards.Count <= 1)
            return; // never delete the last dashboard

        _collection.Dashboards.Remove(target);

        // If the deleted tab was the active one, switch to another tab
        if (ReferenceEquals(target, _activeDashboard))
        {
            _activeDashboard = _collection.Dashboards[0];
            _collection.ActiveDashboardId = _activeDashboard.Id;
            ResetTransientState();
            await ResetGrid();
        }

        await SaveDashboard();
    }

    private void ToggleActions() => _actionsOpen = !_actionsOpen;

    private async Task ExportDashboard()
    {
        _actionsOpen = false;
        if (_collection is null || _collection.Dashboards.Count == 0) return;

        // Create a clean export object without internal state.
        // Version 2 exports the WHOLE collection (every dashboard), not just
        // the active one. The active dashboard is recorded by index so that
        // ids can be regenerated on import without breaking the reference.
        var activeIndex = _activeDashboard is null
            ? 0
            : Math.Max(0, _collection.Dashboards.IndexOf(_activeDashboard));

        var export = new
        {
            Version = 2,
            ActiveDashboardIndex = activeIndex,
            Dashboards = _collection.Dashboards.Select(d => new
            {
                d.Name,
                d.Description,
                Widgets = d.Widgets.OrderBy(w => w.Order).Select(w => new
                {
                    w.WidgetType,
                    w.ColumnSize,
                    w.RowSpan,
                    w.Offset,
                    w.Row,
                    w.Order,
                    w.Locked,
                    w.Config
                })
            })
        };

        var json = JsonSerializer.Serialize(export, new JsonSerializerOptions { WriteIndented = true });
        await JsInterop.DownloadJsonAsync("dashboard-collection.json", json, Interactive, _disposeCts.Token);
    }

    private async Task ImportDashboard()
    {
        _actionsOpen = false;
        var json = await JsInterop.ReadFileAsTextAsync(_importFileInput, Interactive, _disposeCts.Token);
        if (string.IsNullOrWhiteSpace(json)) return;
        if (_collection is null) return;

        try
        {
            var imported = JsonNode.Parse(json) as JsonObject;
            if (imported is null) return;

            List<DashboardDefinition> dashboards;
            var activeIndex = 0;

            if (imported["Dashboards"] is JsonArray dashboardsArray)
            {
                // Version 2: whole-collection export.
                dashboards = new List<DashboardDefinition>(dashboardsArray.Count);
                foreach (var d in dashboardsArray)
                {
                    if (d is JsonObject dobj) dashboards.Add(ReadDashboard(dobj));
                }
                activeIndex = imported["ActiveDashboardIndex"]?.GetValue<int>() ?? 0;
            }
            else
            {
                // Version 1 (legacy single-dashboard export): treat the file as
                // a one-dashboard collection so both formats share one code path.
                dashboards = new List<DashboardDefinition> { ReadDashboard(imported) };
            }

            if (dashboards.Count == 0) return;

            // Replace the entire collection content so the owner-keyed save
            // persists exactly what was in the file.
            _collection.Dashboards.Clear();
            _collection.Dashboards.AddRange(dashboards);
            _activeDashboard = _collection.Dashboards[Math.Clamp(activeIndex, 0, dashboards.Count - 1)];
            _collection.ActiveDashboardId = _activeDashboard.Id;

            ResetTransientState();
            await SaveDashboard();
            await ResetGrid();
        }
        catch (JsonException)
        {
            // A malformed user-supplied import file must not crash the dashboard.
        }
    }

    /// <summary>
    /// Builds a dashboard from an exported JSON object (shared by the v2
    /// collection format and the legacy v1 single-dashboard format).
    /// All ids are regenerated; nothing external references the old ones.
    /// </summary>
    private static DashboardDefinition ReadDashboard(JsonObject source)
    {
        var dashboard = new DashboardDefinition
        {
            Id = Guid.NewGuid().ToString(),
            Name = source["Name"]?.GetValue<string>() ?? "Imported Dashboard",
            Description = source["Description"]?.GetValue<string>()
        };

        if (source["Widgets"] is JsonArray widgetsArray)
        {
            var order = 0;
            foreach (var w in widgetsArray)
            {
                if (w is not JsonObject wo) continue;
                dashboard.Widgets.Add(new WidgetPlacement
                {
                    Id = Guid.NewGuid().ToString(),
                    WidgetType = wo["WidgetType"]?.GetValue<string>() ?? "",
                    ColumnSize = wo["ColumnSize"]?.GetValue<int>() ?? 6,
                    RowSpan = wo["RowSpan"]?.GetValue<int>() ?? 1,
                    // Preserve null (auto-flow). Coercing missing offsets to 0 would pin
                    // every imported widget to column 0 under the new nullable semantics.
                    Offset = wo["Offset"]?.GetValue<int?>(),
                    Row = wo["Row"]?.GetValue<int?>(),
                    Order = wo["Order"]?.GetValue<int>() ?? order,
                    Locked = wo["Locked"]?.GetValue<bool>() ?? false,
                    Config = wo["Config"]?.DeepClone() as JsonObject
                });
                order++;
            }
        }

        return dashboard;
    }

    private async Task SaveDashboard()
    {
        if (string.IsNullOrEmpty(OwnerKey) || _collection is null || _activeDashboard is null)
            return;
        await DashboardService.SaveAsync(OwnerKey, _collection, _disposeCts.Token);
        if (OnDashboardChanged.HasDelegate)
            await OnDashboardChanged.InvokeAsync();
    }

    public async ValueTask DisposeAsync()
    {
        _disposeCts.Cancel();
        _disposeCts.Dispose();
        // Sole owner of _dotNetRef: DashboardJsInterop only borrows it, so the host
        // is responsible for disposing it here.
        _dotNetRef?.Dispose();
        await JsInterop.DestroyGridAsync(Interactive, CancellationToken.None);
    }
}